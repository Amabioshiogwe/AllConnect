// AllConnect - File 1: Shell
// Splash + Conference layout (top bar, video grid, toolbar, tabs)

import 'dart:async';
import 'package:flutter/material.dart';

void main() => runApp(const AllConnectApp());

class AllConnectApp extends StatelessWidget {
  const AllConnectApp({super.key});
  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'All Connect',
      debugShowCheckedModeBanner: false,
      theme: ThemeData(
        primaryColor: const Color(0xFF2E7D32),
        scaffoldBackgroundColor: Colors.white,
      ),
      home: const SplashScreen(),
    );
  }
}

class SplashScreen extends StatefulWidget {
  const SplashScreen({super.key});
  @override
  State<SplashScreen> createState() => _SplashScreenState();
}

class _SplashScreenState extends State<SplashScreen> {
  @override
  void initState() {
    super.initState();
    Timer(const Duration(seconds: 3), () {
      if (mounted) {
        Navigator.pushReplacement(context,
            MaterialPageRoute(builder: (_) => const ConferenceScreen()));
      }
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: const Color(0xFF2E7D32),
      body: Center(
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            Container(
              width: 100,
              height: 100,
              decoration: BoxDecoration(
                color: Colors.white,
                borderRadius: BorderRadius.circular(20),
              ),
              child: const Center(
                child: Text('AC',
                    style: TextStyle(
                        fontSize: 40,
                        fontWeight: FontWeight.bold,
                        color: Color(0xFF2E7D32))),
              ),
            ),
            const SizedBox(height: 20),
            const Text('All Connect',
                style: TextStyle(
                    fontSize: 32,
                    color: Colors.white,
                    fontWeight: FontWeight.bold)),
            const SizedBox(height: 8),
            const Text('Connect Everywhere, Connect Everyone',
                style: TextStyle(fontSize: 14, color: Colors.white70)),
          ],
        ),
      ),
    );
  }
}

class ConferenceScreen extends StatefulWidget {
  const ConferenceScreen({super.key});
  @override
  State<ConferenceScreen> createState() => _ConferenceScreenState();
}

class _ConferenceScreenState extends State<ConferenceScreen> {
  final String meetingId = 'AC-1234';
  final String meetingType = 'Church';
  int totalMinutes = 124;
  int walletBalance = 124;
  int timerSeconds = 0;

  bool micOn = true;
  bool camOn = true;
  bool screenShareOn = false;
  bool splitScreen = false;
  bool blurBackground = false;
  bool noiseFilter = false;

  bool isRecording = false;
  int recordingSeconds = 0;

  bool isLiveStreaming = false;
  int liveViewerCount = 0;

  int bottomTab = 0;

  @override
  void initState() {
    super.initState();
    Timer.periodic(const Duration(seconds: 60), (t) {
      if (!mounted) return;
      setState(() {
        totalMinutes++;
        walletBalance++;
        if (isRecording) recordingSeconds++;
        if (isLiveStreaming) liveViewerCount++;
      });
    });
    Timer.periodic(const Duration(seconds: 1), (t) {
      if (!mounted) return;
      setState(() {
        timerSeconds++;
        if (isRecording) recordingSeconds++;
      });
    });
  }

  void toggleRecord() {
    setState(() {
      isRecording = !isRecording;
      if (isRecording) recordingSeconds = 0;
    });
    ScaffoldMessenger.of(context).showSnackBar(SnackBar(
        content: Text(isRecording
            ? 'Recording started - All notified'
            : 'Recording saved'),
        duration: const Duration(seconds: 2)));
  }

  void toggleLive() {
    setState(() {
      isLiveStreaming = !isLiveStreaming;
      liveViewerCount = isLiveStreaming ? 24 : 0;
    });
    ScaffoldMessenger.of(context).showSnackBar(SnackBar(
        content: Text(isLiveStreaming
            ? 'Live started to YouTube + Facebook'
            : 'Live stopped'),
        duration: const Duration(seconds: 2)));
  }

  String _fmt(int s) =>
      '${(s ~/ 60).toString().padLeft(2, '0')}:${(s % 60).toString().padLeft(2, '0')}';

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: SafeArea(
        child: Column(
          children: [
            Expanded(flex: 40, child: _topArea()),
            Expanded(flex: 60, child: _bottomArea()),
          ],
        ),
      ),
    );
  }

  Widget _topArea() {
    return Column(
      children: [
        _topBar(),
        Expanded(child: _videoGrid()),
        _toolbar(),
      ],
    );
  }

  Widget _topBar() {
    return Container(
      color: const Color(0xFF2E7D32),
      padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
      child: Column(
        children: [
          Row(children: [
            const Text('All Connect',
                style: TextStyle(
                    color: Colors.white,
                    fontWeight: FontWeight.bold,
                    fontSize: 13)),
            const SizedBox(width: 6),
            Text(meetingId,
                style: const TextStyle(color: Colors.white70, fontSize: 11)),
            const Spacer(),
            Text(_fmt(timerSeconds),
                style: const TextStyle(color: Colors.white, fontSize: 12)),
          ]),
          const SizedBox(height: 2),
          Row(children: [
            Container(
              padding: const EdgeInsets.symmetric(horizontal: 6, vertical: 2),
              decoration: BoxDecoration(
                color: const Color(0xFFFFC107),
                borderRadius: BorderRadius.circular(8),
              ),
              child: Text(meetingType,
                  style: const TextStyle(fontSize: 10, color: Colors.black)),
            ),
            const SizedBox(width: 6),
            if (isRecording)
              Row(children: [
                const Icon(Icons.circle, color: Colors.red, size: 8),
                const SizedBox(width: 3),
                Text('REC ${_fmt(recordingSeconds)}',
                    style: const TextStyle(color: Colors.white, fontSize: 10)),
              ]),
            if (isLiveStreaming)
              const Padding(
                padding: EdgeInsets.only(left: 6),
                child: Text('LIVE',
                    style: TextStyle(
                        color: Colors.red,
                        fontWeight: FontWeight.bold,
                        fontSize: 11)),
              ),
            const Spacer(),
            GestureDetector(
              onTap: () {
                setState(() {
                  isRecording = false;
                  isLiveStreaming = false;
                });
                ScaffoldMessenger.of(context).showSnackBar(const SnackBar(
                    content: Text('You left the meeting')));
              },
              child: Container(
                padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 3),
                decoration: BoxDecoration(
                  color: Colors.red,
                  borderRadius: BorderRadius.circular(6),
                ),
                child: const Text('Leave',
                    style: TextStyle(color: Colors.white, fontSize: 11)),
              ),
            ),
          ]),
          const SizedBox(height: 2),
          Row(children: [
            Text(
                '$totalMinutes mins = $totalMinutes pts | Wallet N${walletBalance * 2}',
                style: const TextStyle(color: Colors.white70, fontSize: 10)),
          ]),
        ],
      ),
    );
  }

  Widget _videoGrid() {
    final names = [
      'You',
      'Pastor James',
      'Student Aisha',
      'Sister Grace',
      'Bro John',
      'Sis Mary'
    ];
    final colors = [
      Colors.green.shade200,
      Colors.blue.shade200,
      Colors.orange.shade200,
      Colors.purple.shade200,
      Colors.teal.shade200,
      Colors.pink.shade200,
    ];
    return Container(
      color: Colors.black,
      padding: const EdgeInsets.all(4),
      child: GridView.builder(
        physics: const NeverScrollableScrollPhysics(),
        gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(
          crossAxisCount: 3,
          childAspectRatio: 1.0,
          crossAxisSpacing: 4,
          mainAxisSpacing: 4,
        ),
        itemCount: 6,
        itemBuilder: (c, i) {
          return Container(
            decoration: BoxDecoration(
              color: colors[i],
              borderRadius: BorderRadius.circular(6),
            ),
            child: Stack(children: [
              Center(
                child: Text(names[i],
                    style: const TextStyle(
                        fontSize: 10, fontWeight: FontWeight.bold)),
              ),
              Positioned(
                bottom: 3,
                right: 3,
                child: Row(children: [
                  Icon(i == 0 && !micOn ? Icons.mic_off : Icons.mic,
                      size: 12, color: Colors.white),
                  const SizedBox(width: 3),
                  Icon(
                      i == 0 && !camOn
                          ? Icons.videocam_off
                          : Icons.videocam,
                      size: 12,
                      color: Colors.white),
                ]),
              ),
              if (isRecording)
                const Positioned(
                  top: 3,
                  right: 3,
                  child: Icon(Icons.fiber_manual_record,
                      color: Colors.red, size: 12),
                ),
            ]),
          );
        },
      ),
    );
  }

  Widget _toolbar() {
    return Container(
      color: const Color(0xFF2E7D32),
      padding: const EdgeInsets.symmetric(vertical: 6, horizontal: 4),
      child: SingleChildScrollView(
        scrollDirection: Axis.horizontal,
        child: Row(children: [
          _tbtn(micOn ? Icons.mic : Icons.mic_off, 'Mic',
              () => setState(() => micOn = !micOn)),
          _tbtn(camOn ? Icons.videocam : Icons.videocam_off, 'Cam',
              () => setState(() => camOn = !camOn)),
          _tbtn(Icons.screen_share, 'Share',
              () => setState(() => screenShareOn = !screenShareOn)),
          _tbtn(Icons.grid_view, 'Split',
              () => setState(() => splitScreen = !splitScreen)),
          _tbtn(Icons.blur_on, 'Blur',
              () => setState(() => blurBackground = !blurBackground)),
          _tbtn(Icons.noise_control_off, 'Noise',
              () => setState(() => noiseFilter = !noiseFilter)),
          _tbtn(
              isRecording ? Icons.stop_circle : Icons.fiber_manual_record,
              isRecording ? 'Stop' : 'Rec',
              toggleRecord),
          _tbtn(isLiveStreaming ? Icons.stop : Icons.podcasts,
              isLiveStreaming ? 'End' : 'Live', toggleLive),
        ]),
      ),
    );
  }

  Widget _tbtn(IconData icon, String label, VoidCallback onTap) {
    return GestureDetector(
      onTap: onTap,
      child: Container(
        margin: const EdgeInsets.symmetric(horizontal: 4),
        padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
        decoration: BoxDecoration(
          color: Colors.white24,
          borderRadius: BorderRadius.circular(6),
        ),
        child: Column(children: [
          Icon(icon, color: Colors.white, size: 18),
          Text(label,
              style: const TextStyle(color: Colors.white, fontSize: 9)),
        ]),
      ),
    );
  }

  Widget _bottomArea() {
    final tabs = [
      'Live Chat',
      'Emojis',
      'Bible',
      'Quran',
      'PDF',
      'Notepad',
      'Recording',
      'Live Stream',
      'Wallet',
    ];
    return Column(children: [
      Container(
        height: 36,
        color: Colors.grey.shade200,
        child: ListView.builder(
          scrollDirection: Axis.horizontal,
          itemCount: tabs.length,
          itemBuilder: (c, i) => GestureDetector(
            onTap: () => setState(() => bottomTab = i),
            child: Container(
              padding: const EdgeInsets.symmetric(horizontal: 10),
              alignment: Alignment.center,
              decoration: BoxDecoration(
                border: Border(
                  bottom: BorderSide(
                    color: bottomTab == i
                        ? const Color(0xFF2E7D32)
                        : Colors.transparent,
                    width: 2,
                  ),
                ),
              ),
              child: Text(tabs[i],
                  style: TextStyle(
                      fontSize: 11,
                      color: bottomTab == i
                          ? const Color(0xFF2E7D32)
                          : Colors.black54,
                      fontWeight: bottomTab == i
                          ? FontWeight.bold
                          : FontWeight.normal)),
            ),
          ),
        ),
      ),
      Expanded(
        child: Center(
          child: Text('${tabs[bottomTab]} content coming in File 2 and 3',
              style: const TextStyle(color: Colors.grey)),
        ),
      ),
    ]);
  }
}

